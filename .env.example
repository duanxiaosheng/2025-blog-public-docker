# Optional: set this only if you want to force a fixed admin password from environment.
# If omitted, open the site for the first time and initialize the admin password in the UI.
# ADMIN_PASSWORD=

# Optional: set this only if you need a fixed session secret.
# If omitted, the app generates one automatically and stores it under data/config/admin-auth.json.
# SESSION_SECRET=

NODE_ENV=production
PORT=3000
DATA_DIR=/app/data
IMAGE_NAME=duanxiaosheng/2025-blog-local-docker:latest
